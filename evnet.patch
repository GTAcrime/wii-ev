diff --git a/src/platform/wii/evnet.c b/src/platform/wii/evnet.c
new file mode 100644
index 0000000..5788fed
--- /dev/null
+++ b/src/platform/wii/evnet.c
@@ -0,0 +1,983 @@
+/* EV Counter: streams GBA memory over TCP so a PC can read it live.
+ *
+ * The Wii listens on EVNET_PORT. A client receives a stream of messages:
+ *   magic 'EVM1' (4 bytes), GBA address (u32), length (u32)  -- big-endian header
+ *   followed by <length> bytes of GBA memory in GBA (little-endian) byte order.
+ *
+ * Video (WiiScreen on the PC): a second server on EVNET_VIDEO_PORT. Every message has a 16-byte big-endian header:
+ *   magic (4), a (u32), b (u16), c (u16), payload length (u32). Each pass of the sender loop sends ALL its messages
+ *   with one vidSendAll (every IOS send call costs time).
+ *   'EVA1' sound, sent first: a = samples sent before, b = n, c = 1 (PCM); payload n stereo samples s16 BE,
+ *          left then right, 24 kHz (mGBA's 48 kHz averaged in pairs, ~95 KB/s). IMA ADPCM measured poorly.
+ *   'EVF2' picture: a = frame number, b = width, c = height (0 x 0 = keep-alive). Payload: dx s8, dy s8, 0, 0;
+ *          2-bit row modes ((h * 2 + 7) / 8 bytes, row 0 in the top bits: 0 same, 1 raw, 2 xor); one LZ4 block
+ *          with the raw / xor rows. Reference row = previous frame moved by (dx, dy) (scrolling), zero outside.
+ *          Pixels RGB565 big-endian, as in mGBA's output buffer.
+ *   'EVS1' once a second: frames sent, frames skipped, encode us, send us, longest send us, send calls (u32 each).
+ * The video thread runs BELOW the emulator's priority and takes the newest frame each time, so a slow
+ * network only lowers the frame rate on the PC; the game never waits for it. Port 5555 is unchanged.
+ *
+ * Design goals: it must come up every time, whatever happens.
+ *  - the server thread never exits: it retries the network stack and the listening
+ *    socket until they work, and rebuilds them if the connection layer breaks;
+ *  - the game can be loaded/unloaded/reloaded any number of times;
+ *  - the emulator memory is only touched in short slices, and evnet_stop() waits for
+ *    a slice in progress, so the core can never be freed while it is being read.
+ */
+#include "evnet.h"
+
+#include <errno.h>
+#include <network.h>
+#include <ogcsys.h>
+#include <ogc/lwp.h>
+#include <ogc/lwp_watchdog.h>
+#include <ogc/mutex.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+/* Event log written to the SD card root, so a failure can be read on the PC afterwards. */
+#ifndef EVNET_LOG_PATH
+#define EVNET_LOG_PATH "sd:/evnet.log"
+#endif
+#ifndef EVNET_LOG_PATH2
+#define EVNET_LOG_PATH2 "usb:/evnet.log"
+#endif
+#ifndef EVNET_PRIORITY
+#define EVNET_PRIORITY 90 /* above mGBA's own thread: this thread sleeps almost all the time */
+#endif
+#define EVNET_LOG_MAX_LINES 400
+#define EVNET_PORT_COUNT 10 /* try EVNET_PORT .. EVNET_PORT+9: a stale socket may still hold the first ones */
+
+static int evLogLines = 0;
+static void evlog(const char* fmt, ...) {
+	if (evLogLines >= EVNET_LOG_MAX_LINES) {
+		return;
+	}
+	char line[200];
+	va_list args;
+	va_start(args, fmt);
+	vsnprintf(line, sizeof(line), fmt, args);
+	va_end(args);
+	FILE* f = fopen(EVNET_LOG_PATH, "a");
+	if (!f) {
+		f = fopen(EVNET_LOG_PATH2, "a");
+	}
+	if (f) {
+		fprintf(f, "%s\n", line);
+		fclose(f);
+		++evLogLines;
+	}
+}
+
+#ifndef SOL_SOCKET
+#define SOL_SOCKET 0xfff
+#endif
+
+#define TICK_US 250000
+#define CHUNK 4096
+#define EWRAM_BASE 0x02000000
+#define EWRAM_SIZE 0x40000
+#define IWRAM_BASE 0x03000000
+#define IWRAM_SIZE 0x8000
+#define ROM_BASE 0x08000000
+#define ROM_SCAN_LIMIT 0x08800000
+#define ROM_BASESTATS_SIZE 0x3000 /* gBaseStats (EV yields), located by scanning the ROM */
+#define SCAN_STEP 0x10000         /* words scanned per tick while looking for gBaseStats */
+#define MARKER_ADDR 0xFFFFFFF0    /* pseudo address: payload = ROM address of gBaseStats */
+#define RESET_ADDR 0xFFFFFFE0     /* pseudo address: payload = "Reset game" count since the dol started (u32) */
+#define HEADER_ADDR 0x080000A0    /* ROM header (game code at 0xAC, version at 0xBC) */
+#define PARTY_BLOCK 0x0202402C    /* covers gEnemyParty+gPlayerParty of FireRed AND Emerald */
+#define PARTY_BLOCK_SIZE 2328
+#define RS_PARTY_BLOCK 0x03004360 /* covers gPlayerParty+gEnemyParty of Ruby AND Sapphire (in IWRAM) */
+#define RS_MAIN_BLOCK 0x03001770  /* gMain of Ruby/Sapphire: inBattle flag at +0x43D, needed to reveal the starter at once */
+#define RS_MAIN_BLOCK_SIZE 0x440
+#define RS_PARTY_BLOCK_SIZE 700   /* 0x03004360 + 600 = 0x030045B8 (player), 0x030045C0 + 100 = 0x03004624 (enemy) */
+#define CHUNKS ((IWRAM_SIZE + EWRAM_SIZE + ROM_BASESTATS_SIZE) / CHUNK)
+
+static struct mCore* volatile evCore = NULL;
+static volatile bool evReading = false;      /* the server thread is inside the core right now */
+static volatile bool evReset = true;         /* a (new) game was loaded: forget what we learned */
+static lwp_t evThread;
+static volatile bool evThreadStarted = false;
+
+/* learned about the current game */
+static uint32_t evBaseStats = 0;
+static bool evScanDone = false;
+static uint32_t evScanPos = ROM_BASE;
+static bool evScanning = false;
+
+/* sockets, so they can be closed when mGBA exits (a leaked listening socket blocks the port until reboot) */
+static s32 evServerSock = -1;
+static s32 evClientSock = -1;
+static bool evAtExitSet = false;
+
+/* "Reset game" presses since the dol started, sent every tick so the PC counts each one exactly once */
+static volatile uint32_t evResetCount = 0;
+
+void evnet_reset(void) {
+	++evResetCount;
+}
+
+/* one tick worth of data, filled while reading the core, sent afterwards */
+static uint8_t outBuf[(12 + 32) + 2 * 16 + (12 + PARTY_BLOCK_SIZE) + (12 + RS_PARTY_BLOCK_SIZE) + (12 + RS_MAIN_BLOCK_SIZE) + 2 * (12 + CHUNK)];
+
+#ifndef IOS_O_NONBLOCK
+#define IOS_O_NONBLOCK 0x04
+#endif
+#ifndef F_GETFL
+#define F_GETFL 3
+#endif
+#ifndef F_SETFL
+#define F_SETFL 4
+#endif
+#define EVNET_SEND_TIMEOUT_MS 1500 /* a client that does not read for this long is dropped */
+
+static void setNonBlocking(s32 sock) {
+	s32 flags = net_fcntl(sock, F_GETFL, 0);
+	net_fcntl(sock, F_SETFL, (flags < 0 ? 0 : flags) | IOS_O_NONBLOCK);
+}
+
+static bool wouldBlock(s32 res) {
+	return res == -EAGAIN || res == -EWOULDBLOCK;
+}
+
+/* Sockets are non-blocking: a dead or stalled client can never hang the server thread. */
+static bool sendAll(s32 sock, const void* data, size_t len) {
+	const uint8_t* p = data;
+	u64 start = gettime();
+	while (len > 0) {
+		s32 n = net_send(sock, p, len > 1024 ? 1024 : (s32) len, 0);
+		if (n > 0) {
+			p += n;
+			len -= n;
+			start = gettime();
+			continue;
+		}
+		if (!wouldBlock(n) || ticks_to_millisecs(diff_ticks(start, gettime())) >= EVNET_SEND_TIMEOUT_MS) {
+			return false;
+		}
+		usleep(5000);
+	}
+	return true;
+}
+
+static size_t appendHeader(size_t pos, uint32_t addr, uint32_t len) {
+	outBuf[pos + 0] = 'E';
+	outBuf[pos + 1] = 'V';
+	outBuf[pos + 2] = 'M';
+	outBuf[pos + 3] = '1';
+	outBuf[pos + 4] = addr >> 24;
+	outBuf[pos + 5] = addr >> 16;
+	outBuf[pos + 6] = addr >> 8;
+	outBuf[pos + 7] = addr;
+	outBuf[pos + 8] = len >> 24;
+	outBuf[pos + 9] = len >> 16;
+	outBuf[pos + 10] = len >> 8;
+	outBuf[pos + 11] = len;
+	return pos + 12;
+}
+
+static size_t appendRegion(size_t pos, struct mCore* core, uint32_t addr, uint32_t len) {
+	pos = appendHeader(pos, addr, len);
+	uint32_t i;
+	for (i = 0; i < len; i += 4) {
+		uint32_t value = core->rawRead32(core, addr + i, -1);
+		outBuf[pos + i] = value;
+		outBuf[pos + i + 1] = value >> 8;
+		outBuf[pos + i + 2] = value >> 16;
+		outBuf[pos + i + 3] = value >> 24;
+	}
+	return pos + len;
+}
+
+static size_t appendMarker(size_t pos, uint32_t value) {
+	pos = appendHeader(pos, MARKER_ADDR, 4);
+	outBuf[pos] = value;
+	outBuf[pos + 1] = value >> 8;
+	outBuf[pos + 2] = value >> 16;
+	outBuf[pos + 3] = value >> 24;
+	return pos + 4;
+}
+
+/* Look for gBaseStats a slice at a time: Bulbasaur's entry (second in the table) is 45 49 49 45 65 65, Grass, Poison. */
+static void scanSlice(struct mCore* core) {
+	uint32_t end = evScanPos + SCAN_STEP * 4;
+	for (; evScanPos < end && evScanPos < ROM_SCAN_LIMIT; evScanPos += 4) {
+		if (core->rawRead32(core, evScanPos + 28, -1) == 0x2D31312D &&
+		    core->rawRead32(core, evScanPos + 32, -1) == 0x030C4141) {
+			evBaseStats = evScanPos;
+			evScanDone = true;
+			return;
+		}
+	}
+	if (evScanPos >= ROM_SCAN_LIMIT) {
+		evScanDone = true;
+	}
+}
+
+/* Fill outBuf with everything for one tick. Returns the length (0 = no game loaded). */
+static size_t buildTick(uint32_t* chunk) {
+	evReading = true;
+	struct mCore* core = evCore;
+	size_t pos = 0;
+	if (core) {
+		if (evReset) {
+			evReset = false;
+			evBaseStats = 0;
+			evScanDone = false;
+			evScanPos = ROM_BASE;
+		}
+		if (!evScanDone) {
+			scanSlice(core);
+		}
+		pos = appendRegion(pos, core, HEADER_ADDR, 32);
+		pos = appendMarker(pos, evBaseStats);
+		{
+			size_t mpos = appendHeader(pos, RESET_ADDR, 4);
+			uint32_t value = evResetCount;
+			outBuf[mpos] = value;
+			outBuf[mpos + 1] = value >> 8;
+			outBuf[mpos + 2] = value >> 16;
+			outBuf[mpos + 3] = value >> 24;
+			pos = mpos + 4;
+		}
+		pos = appendRegion(pos, core, PARTY_BLOCK, PARTY_BLOCK_SIZE);
+		{
+			/* Ruby / Sapphire keep the parties in IWRAM (not covered by PARTY_BLOCK): send them every tick,
+			   so the PC sees the starter and the party wipe of a soft reset without the slow sweep's delay */
+			uint32_t gameCode = core->rawRead32(core, HEADER_ADDR + 0x0C, -1);
+			if (gameCode == 0x45565841 /* 'AXVE' */ || gameCode == 0x45505841 /* 'AXPE' */) {
+				pos = appendRegion(pos, core, RS_PARTY_BLOCK, RS_PARTY_BLOCK_SIZE);
+								pos = appendRegion(pos, core, RS_MAIN_BLOCK, RS_MAIN_BLOCK_SIZE);
+							}
+		}
+		int k;
+		for (k = 0; k < 2; ++k) {
+			uint32_t offset = *chunk * CHUNK;
+			*chunk = (*chunk + 1) % CHUNKS;
+			uint32_t addr;
+			if (offset < IWRAM_SIZE) {
+				addr = IWRAM_BASE + offset;
+			} else if (offset < IWRAM_SIZE + EWRAM_SIZE) {
+				addr = EWRAM_BASE + (offset - IWRAM_SIZE);
+			} else if (evBaseStats) {
+				addr = evBaseStats + (offset - IWRAM_SIZE - EWRAM_SIZE);
+			} else {
+				continue;
+			}
+			pos = appendRegion(pos, core, addr, CHUNK);
+		}
+	}
+	if (!core) {
+		pos = appendMarker(pos, 0);   /* "alive, no game loaded" */
+	}
+	evScanning = core && !evScanDone;
+	evReading = false;
+	return pos;
+}
+
+/* Streams to one client. Returns a NEW client's socket when someone connects (it replaces the current one,
+ * so a restarted EV Counter takes over at once) or -1 when the current client is gone. */
+static s32 serve(s32 server, s32 client) {
+	uint32_t chunk = 0;
+	evlog("client connected");
+	for (;;) {
+		size_t len = buildTick(&chunk);
+		if (len && !sendAll(client, outBuf, len)) {
+			evlog("client gone (send failed or stalled)");
+			return -1;
+		}
+		int waits = evScanning ? 1 : 2; /* still looking for gBaseStats: keep going without waiting */
+		int w;
+		for (w = 0; w < waits; ++w) {
+			struct sockaddr_in peer;
+			socklen_t peerLen = sizeof(peer);
+			s32 next = net_accept(server, (struct sockaddr*) &peer, &peerLen);
+			if (next >= 0) {
+				setNonBlocking(next);
+				evlog("new client replaces the old one");
+				return next;
+			}
+			uint8_t scratch[16];
+			s32 r = net_recv(client, scratch, sizeof(scratch), 0);
+			if (r == 0 || (r < 0 && !wouldBlock(r))) {
+				evlog("client gone (recv %d)", (int) r);
+				return -1;
+			}
+			if (!evScanning) {
+				usleep(TICK_US / 2);
+			}
+		}
+	}
+}
+
+static s32 openServerOn(int port);
+
+static s32 openServer(void) {
+	int port;
+	for (port = EVNET_PORT; port < EVNET_PORT + EVNET_PORT_COUNT; ++port) {
+		s32 server = openServerOn(port);
+		if (server >= 0) {
+			return server;
+		}
+	}
+	evlog("no free port in %d..%d", EVNET_PORT, EVNET_PORT + EVNET_PORT_COUNT - 1);
+	return -1;
+}
+
+static s32 openServerOn(int port) {
+	s32 server = net_socket(AF_INET, SOCK_STREAM, IPPROTO_IP);
+	if (server < 0) {
+		evlog("net_socket failed: %d", (int) server);
+		return -1;
+	}
+	int one = 1;
+	s32 opt = net_setsockopt(server, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+	if (opt < 0) {
+		evlog("SO_REUSEADDR not accepted (%d), continuing", (int) opt);
+	}
+	struct sockaddr_in addr;
+	memset(&addr, 0, sizeof(addr));
+	addr.sin_len = sizeof(addr);
+	addr.sin_family = AF_INET;
+	addr.sin_port = htons(port);
+	addr.sin_addr.s_addr = INADDR_ANY;
+	s32 res = net_bind(server, (struct sockaddr*) &addr, sizeof(addr));
+	if (res < 0) {
+		evlog("net_bind failed on port %d: %d", port, (int) res);
+		net_close(server);
+		return -1;
+	}
+	res = net_listen(server, 2);
+	if (res < 0) {
+		evlog("net_listen failed on port %d: %d", port, (int) res);
+		net_close(server);
+		return -1;
+	}
+	setNonBlocking(server); /* a blocking accept would hold up every other IOS network call */
+	evlog("listening on port %d", port);
+	return server;
+}
+
+/* ------------------------------------------------------------------------------------------------ */
+/* Video: the emulated screen on a second port                                                      */
+/* ------------------------------------------------------------------------------------------------ */
+
+#ifndef EVNET_VIDEO_PORT
+#define EVNET_VIDEO_PORT 5600
+#endif
+#define VIDEO_PORT_COUNT 10
+#ifndef VIDEO_PRIORITY
+#define VIDEO_PRIORITY 20         /* below the emulator: it only gets time the game does not need */
+#endif
+#define VIDEO_MAX_W 240
+#define VIDEO_MAX_H 160
+#define VIDEO_PIXELS (VIDEO_MAX_W * VIDEO_MAX_H)
+#define VIDEO_SEND_CHUNK 8192
+#define VIDEO_KEEPALIVE_MS 1000
+#define VIDEO_HEADER 16
+#define VIDEO_EXTRA 4             /* dx, dy, 0, 0 */
+#define VIDEO_MASK_MAX ((VIDEO_MAX_H * 2 + 7) / 8)
+#define VIDEO_SHIFT_MAX 4         /* walking / running / bike move the screen 1..4 pixels per frame */
+#define LZ4_BOUND(n) ((n) + (n) / 255 + 16)
+#define LZ4_HASH_BITS 12
+#define ROW_SAME 0
+#define ROW_RAW 1
+#define ROW_XOR 2
+#ifndef IOS_O_NONBLOCK
+#define IOS_O_NONBLOCK 0x04
+#endif
+#ifndef F_GETFL
+#define F_GETFL 3
+#endif
+#ifndef F_SETFL
+#define F_SETFL 4
+#endif
+#ifndef SO_SNDBUF
+#define SO_SNDBUF 0x1001
+#endif
+
+#define AUDIO_RING 8192           /* stereo samples at 48 kHz (~170 ms); power of two */
+#define AUDIO_BLOCK 1024          /* 24 kHz stereo samples per message at most */
+#define AUDIO_FORMAT_PCM24 1
+#define STATS_LEN 24
+
+static volatile bool evNetUp = false;            /* set by evMain while the network stack is usable */
+
+static uint16_t vidShared[VIDEO_PIXELS];          /* newest frame, written by the emulator thread */
+static uint16_t vidWork[VIDEO_PIXELS];            /* the frame being encoded */
+static uint16_t vidPrev[VIDEO_PIXELS];            /* the frame the client has */
+static uint16_t vidRefRow[VIDEO_MAX_W];
+static uint16_t vidRowsBuf[VIDEO_PIXELS];         /* raw / xor rows, back to back, before LZ4 */
+#define vidRows ((uint8_t*) vidRowsBuf)
+/* everything sent in one pass of the loop: all waiting sound + stats + one picture, ONE vidSendAll */
+static uint8_t txBuf[(AUDIO_RING / 2 / AUDIO_BLOCK + 1) * VIDEO_HEADER + AUDIO_RING * 2 + VIDEO_HEADER + STATS_LEN +
+                     VIDEO_HEADER + VIDEO_EXTRA + VIDEO_MASK_MAX + LZ4_BOUND(VIDEO_PIXELS * 2)];
+static uint32_t lz4Table[1 << LZ4_HASH_BITS];
+static volatile uint32_t vidSeq = 0;
+static volatile unsigned vidW = 0, vidH = 0;
+static volatile bool vidWanted = false;           /* a client is connected: only then frames / sound are copied */
+static mutex_t vidLock = LWP_MUTEX_NULL;
+static lwp_t vidThread;
+static s32 vidServerSock = -1;
+static s32 vidClientSock = -1;
+
+static uint32_t audRing[AUDIO_RING];              /* samples as mGBA stores them for the Wii's DMA */
+static volatile uint32_t audWrite = 0;            /* written by the emulator (interrupts off), read by vidServe */
+static volatile uint32_t audRead = 0;
+static uint32_t audTotal = 0;
+
+/* Called by the emulator thread for every drawn frame. Never waits: if the video thread is copying the
+ * previous frame right now, this one is skipped. */
+void evnet_frame(const void* pixels, unsigned stride, unsigned w, unsigned h) {
+	if (!vidWanted || !pixels || vidLock == LWP_MUTEX_NULL) {
+		return;
+	}
+	if (w > VIDEO_MAX_W) {
+		w = VIDEO_MAX_W;
+	}
+	if (h > VIDEO_MAX_H) {
+		h = VIDEO_MAX_H;
+	}
+	if (LWP_MutexTryLock(vidLock) != 0) {
+		return;
+	}
+	const uint16_t* src = pixels;
+	unsigned y;
+	for (y = 0; y < h; ++y) {
+		memcpy(&vidShared[y * w], &src[y * stride], w * 2);
+	}
+	vidW = w;
+	vidH = h;
+	++vidSeq;
+	LWP_MutexUnlock(vidLock);
+}
+
+/* Called by mGBA's _postAudioBuffer (interrupts disabled) with the samples it just made for the TV.
+ * Only copies into a ring; if the ring is full (the PC is not reading), the newest samples are dropped. */
+void evnet_audio(const void* samples, unsigned count) {
+	if (!vidWanted || !samples) {
+		return;
+	}
+	const uint32_t* src = samples;
+	uint32_t w = audWrite;
+	uint32_t room = AUDIO_RING - (w - audRead);
+	if (count > room) {
+		count = room;
+	}
+	unsigned i;
+	for (i = 0; i < count; ++i) {
+		audRing[(w + i) & (AUDIO_RING - 1)] = src[i];
+	}
+	audWrite = w + count;
+}
+
+static void putMsg(uint8_t* p, const char* magic, uint32_t a, unsigned b, unsigned c, uint32_t len) {
+	memcpy(p, magic, 4);
+	p[4] = a >> 24;
+	p[5] = a >> 16;
+	p[6] = a >> 8;
+	p[7] = a;
+	p[8] = b >> 8;
+	p[9] = b;
+	p[10] = c >> 8;
+	p[11] = c;
+	p[12] = len >> 24;
+	p[13] = len >> 16;
+	p[14] = len >> 8;
+	p[15] = len;
+}
+
+static void put32(uint8_t* p, uint32_t v) {
+	p[0] = v >> 24;
+	p[1] = v >> 16;
+	p[2] = v >> 8;
+	p[3] = v;
+}
+
+static void audResetStream(void) {
+	audRead = audWrite;
+	audTotal = 0;
+}
+
+/* Append all waiting sound as EVA1 messages (pairs of 48 kHz samples -> one 24 kHz sample). Returns bytes. */
+static size_t audAppend(uint8_t* out) {
+	size_t pos = 0;
+	for (;;) {
+		uint32_t r = audRead;
+		uint32_t n = (audWrite - r) / 2;
+		if (!n) {
+			return pos;
+		}
+		if (n > AUDIO_BLOCK) {
+			n = AUDIO_BLOCK;
+		}
+		putMsg(out + pos, "EVA1", audTotal, n, AUDIO_FORMAT_PCM24, n * 4);
+		uint8_t* d = out + pos + VIDEO_HEADER;
+		uint32_t i;
+		for (i = 0; i < n; ++i) {
+			uint32_t a = audRing[(r + 2 * i) & (AUDIO_RING - 1)];
+			uint32_t b = audRing[(r + 2 * i + 1) & (AUDIO_RING - 1)];
+			/* mGBA's Wii buffer has the channels swapped ("reversed for AUDIO_InitDMA"): the first s16 field holds
+			 * the right channel. Read as one u32 on the big-endian Wii: high half = right, low half = left. */
+			int left = ((int16_t) (a & 0xFFFF) + (int16_t) (b & 0xFFFF)) >> 1;
+			int right = ((int16_t) (a >> 16) + (int16_t) (b >> 16)) >> 1;
+			d[4 * i] = (uint8_t) (left >> 8);
+			d[4 * i + 1] = (uint8_t) left;
+			d[4 * i + 2] = (uint8_t) (right >> 8);
+			d[4 * i + 3] = (uint8_t) right;
+		}
+		audRead = r + 2 * n;
+		audTotal += n;
+		pos += VIDEO_HEADER + n * 4;
+	}
+}
+
+static inline uint32_t rd32(const uint8_t* p) {
+	uint32_t v;
+	memcpy(&v, p, 4);
+	return v;
+}
+
+static inline uint32_t lz4Hash(uint32_t v) {
+	return (v * 2654435761u) >> (32 - LZ4_HASH_BITS);
+}
+
+static uint8_t* lz4Len(uint8_t* op, size_t len) {
+	while (len >= 255) {
+		*op++ = 255;
+		len -= 255;
+	}
+	*op++ = (uint8_t) len;
+	return op;
+}
+
+/* Plain greedy LZ4 block compressor (standard block format, decodable by any LZ4 decoder). */
+static size_t lz4Compress(const uint8_t* src, size_t n, uint8_t* dst) {
+	const uint8_t* ip = src;
+	const uint8_t* anchor = src;
+	const uint8_t* const end = src + n;
+	uint8_t* op = dst;
+	if (n >= 13) {
+		const uint8_t* const mflimit = end - 12;     /* a match must start 12+ bytes before the end */
+		const uint8_t* const matchlimit = end - 5;   /* the last 5 bytes are always literals */
+		unsigned misses = 0;
+		memset(lz4Table, 0, sizeof(lz4Table));
+		while (ip < mflimit) {
+			uint32_t seq = rd32(ip);
+			uint32_t h = lz4Hash(seq);
+			const uint8_t* ref = src + lz4Table[h];
+			lz4Table[h] = (uint32_t) (ip - src);
+			if (ref >= ip || ip - ref > 65535 || rd32(ref) != seq) {
+				ip += 1 + (misses++ >> 6);           /* skip faster through data that does not compress */
+				continue;
+			}
+			misses = 0;
+			const uint8_t* mp = ip + 4;
+			const uint8_t* rp = ref + 4;
+			while (mp < matchlimit && *mp == *rp) {
+				++mp;
+				++rp;
+			}
+			size_t lit = ip - anchor;
+			size_t mlen = mp - ip - 4;
+			uint8_t* token = op++;
+			*token = (uint8_t) ((lit >= 15 ? 15 : lit) << 4);
+			if (lit >= 15) {
+				op = lz4Len(op, lit - 15);
+			}
+			memcpy(op, anchor, lit);
+			op += lit;
+			uint32_t off = (uint32_t) (ip - ref);
+			*op++ = off & 0xFF;
+			*op++ = off >> 8;
+			*token |= (uint8_t) (mlen >= 15 ? 15 : mlen);
+			if (mlen >= 15) {
+				op = lz4Len(op, mlen - 15);
+			}
+			ip = mp;
+			anchor = ip;
+		}
+	}
+	size_t lit = end - anchor;
+	uint8_t* token = op++;
+	*token = (uint8_t) ((lit >= 15 ? 15 : lit) << 4);
+	if (lit >= 15) {
+		op = lz4Len(op, lit - 15);
+	}
+	memcpy(op, anchor, lit);
+	op += lit;
+	return op - dst;
+}
+
+/* The whole screen moved (walking): find (dx, dy) so that new(x, y) == prev(x + dx, y + dy) for most pixels.
+ * Checks 6 rows, every 2nd pixel, all shifts up to VIDEO_SHIFT_MAX. (0, 0) unless a shift is clearly better. */
+static void vidFindShift(unsigned w, unsigned h, int* outDx, int* outDy) {
+	int best = -1, bestDx = 0, bestDy = 0, still = 0, total = 0;
+	int dx, dy, k;
+	*outDx = *outDy = 0;
+	if (w <= 2 * VIDEO_SHIFT_MAX || h <= 2 * VIDEO_SHIFT_MAX) {
+		return;
+	}
+	for (dy = -VIDEO_SHIFT_MAX; dy <= VIDEO_SHIFT_MAX; ++dy) {
+		for (dx = -VIDEO_SHIFT_MAX; dx <= VIDEO_SHIFT_MAX; ++dx) {
+			int score = 0, count = 0;
+			for (k = 0; k < 6; ++k) {
+				unsigned y = VIDEO_SHIFT_MAX + (h - 2 * VIDEO_SHIFT_MAX) * (2 * k + 1) / 12;
+				const uint16_t* row = &vidWork[y * w];
+				const uint16_t* ref = &vidPrev[((int) y + dy) * (int) w + dx];
+				unsigned x;
+				for (x = VIDEO_SHIFT_MAX; x < w - VIDEO_SHIFT_MAX; x += 2) {
+					score += row[x] == ref[x];
+					++count;
+				}
+			}
+			total = count;
+			if (dx == 0 && dy == 0) {
+				still = score;
+			}
+			if (score > best) {
+				best = score;
+				bestDx = dx;
+				bestDy = dy;
+			}
+		}
+	}
+	if (best > still + total / 8 && best * 4 > total * 3) {
+		*outDx = bestDx;
+		*outDy = bestDy;
+	}
+}
+
+/* EVF2 picture message for vidWork, appended at out. Each row is SAME (= reference row), RAW pixels, or XOR with
+ * the reference row (few pixels changed: compresses to almost nothing). The reference row is the previous frame
+ * moved by (dx, dy), zero outside it. Then vidPrev = vidWork. */
+static size_t vidEncode(uint8_t* out, uint32_t seq, unsigned w, unsigned h, bool full) {
+	int dx = 0, dy = 0;
+	if (!full) {
+		vidFindShift(w, h, &dx, &dy);
+	}
+	uint8_t* extra = out + VIDEO_HEADER;
+	extra[0] = (uint8_t) (int8_t) dx;
+	extra[1] = (uint8_t) (int8_t) dy;
+	extra[2] = extra[3] = 0;
+	uint8_t* mask = extra + VIDEO_EXTRA;
+	size_t maskLen = (h * 2 + 7) / 8;
+	size_t n = 0;
+	unsigned y, x;
+	memset(mask, 0, maskLen);
+	for (y = 0; y < h; ++y) {
+		const uint16_t* row = &vidWork[y * w];
+		unsigned mode = ROW_RAW;
+		if (!full) {
+			const uint16_t* ref = vidRefRow;
+			int sy = (int) y + dy;
+			if (dx == 0 && sy >= 0 && sy < (int) h) {
+				ref = &vidPrev[sy * w];
+			} else {
+				for (x = 0; x < w; ++x) {
+					int sx = (int) x + dx;
+					vidRefRow[x] = (sy >= 0 && sy < (int) h && sx >= 0 && sx < (int) w) ? vidPrev[sy * w + sx] : 0;
+				}
+			}
+			unsigned diff = 0;
+			for (x = 0; x < w; ++x) {
+				diff += row[x] != ref[x];
+			}
+			if (diff == 0) {
+				mode = ROW_SAME;
+			} else if (diff * 2 < w) {
+				mode = ROW_XOR;
+				uint16_t* o = (uint16_t*) &vidRows[n];
+				for (x = 0; x < w; ++x) {
+					o[x] = row[x] ^ ref[x];
+				}
+				n += w * 2;
+			}
+		}
+		if (mode == ROW_RAW) {
+			memcpy(&vidRows[n], row, w * 2);
+			n += w * 2;
+		}
+		mask[y >> 2] |= mode << (6 - 2 * (y & 3));
+	}
+	size_t packed = n ? lz4Compress(vidRows, n, mask + maskLen) : 0;
+	memcpy(vidPrev, vidWork, w * h * 2);
+	uint32_t len = (uint32_t) (VIDEO_EXTRA + maskLen + packed);
+	putMsg(out, "EVF2", seq, w, h, len);
+	return VIDEO_HEADER + len;
+}
+
+static bool vidSendAll(s32 sock, const uint8_t* p, size_t len) {
+	while (len > 0) {
+		s32 n = net_send(sock, p, len > VIDEO_SEND_CHUNK ? VIDEO_SEND_CHUNK : (s32) len, 0);
+		if (n <= 0) {
+			return false;
+		}
+		p += n;
+		len -= n;
+	}
+	return true;
+}
+
+static void vidServe(s32 client) {
+	uint32_t lastSeq = vidSeq;
+	unsigned lastW = 0, lastH = 0;
+	u64 lastSend = gettime(), statStart = gettime();
+	uint32_t stSent = 0, stSkipped = 0, stEncodeUs = 0, stSendUs = 0, stSendMaxUs = 0, stSends = 0;
+	int sndbuf = 64 * 1024;
+	if (net_setsockopt(client, SOL_SOCKET, SO_SNDBUF, &sndbuf, sizeof(sndbuf)) < 0) {
+		evlog("video: SO_SNDBUF not accepted, continuing");
+	}
+	evlog("video client connected");
+	vidWanted = true;
+	audResetStream();
+	for (;;) {
+		size_t pos = audAppend(txBuf);             /* sound first: it must never wait behind a picture */
+		bool frame = vidSeq != lastSeq && evCore;
+		if (frame) {
+			u64 t0 = gettime();
+			LWP_MutexLock(vidLock);
+			unsigned w = vidW, h = vidH;
+			uint32_t seq = vidSeq;
+			memcpy(vidWork, vidShared, w * h * 2);
+			LWP_MutexUnlock(vidLock);
+			stSkipped += seq - lastSeq - 1;
+			lastSeq = seq;
+			bool full = w != lastW || h != lastH;      /* first frame, or the screen size changed */
+			lastW = w;
+			lastH = h;
+			pos += vidEncode(txBuf + pos, seq, w, h, full);
+			stEncodeUs += (uint32_t) ticks_to_microsecs(diff_ticks(t0, gettime()));
+			++stSent;
+		}
+		u64 now = gettime();
+		if (ticks_to_millisecs(diff_ticks(statStart, now)) >= 1000) {
+			uint8_t* p = txBuf + pos;
+			putMsg(p, "EVS1", 0, 0, 0, STATS_LEN);
+			put32(p + 16, stSent);
+			put32(p + 20, stSkipped);
+			put32(p + 24, stEncodeUs);
+			put32(p + 28, stSendUs);
+			put32(p + 32, stSendMaxUs);
+			put32(p + 36, stSends);
+			pos += VIDEO_HEADER + STATS_LEN;
+			stSent = stSkipped = stEncodeUs = stSendUs = stSendMaxUs = stSends = 0;
+			statStart = now;
+		}
+		if (!pos && ticks_to_millisecs(diff_ticks(lastSend, now)) >= VIDEO_KEEPALIVE_MS) {
+			putMsg(txBuf, "EVF2", lastSeq, 0, 0, 0);   /* no frames (menu / no game): tell the PC we are alive */
+			pos = VIDEO_HEADER;
+		}
+		if (pos) {
+			u64 t1 = gettime();
+			if (!vidSendAll(client, txBuf, pos)) {
+				break;
+			}
+			lastSend = gettime();
+			uint32_t us = (uint32_t) ticks_to_microsecs(diff_ticks(t1, lastSend));
+			stSendUs += us;
+			if (us > stSendMaxUs) {
+				stSendMaxUs = us;
+			}
+			++stSends;
+		}
+		if (!frame) {
+			usleep(1000);
+		}
+	}
+	vidWanted = false;
+	evlog("video client gone");
+}
+
+static s32 vidOpenServer(void) {
+	int port;
+	for (port = EVNET_VIDEO_PORT; port < EVNET_VIDEO_PORT + VIDEO_PORT_COUNT; ++port) {
+		s32 server = net_socket(AF_INET, SOCK_STREAM, IPPROTO_IP);
+		if (server < 0) {
+			evlog("video net_socket failed: %d", (int) server);
+			return -1;
+		}
+		int one = 1;
+		net_setsockopt(server, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+		struct sockaddr_in addr;
+		memset(&addr, 0, sizeof(addr));
+		addr.sin_len = sizeof(addr);
+		addr.sin_family = AF_INET;
+		addr.sin_port = htons(port);
+		addr.sin_addr.s_addr = INADDR_ANY;
+		if (net_bind(server, (struct sockaddr*) &addr, sizeof(addr)) < 0 || net_listen(server, 1) < 0) {
+			net_close(server);
+			continue;
+		}
+		/* non-blocking accept: a waiting video socket must never hold up the IOS network calls of port 5555 */
+		s32 flags = net_fcntl(server, F_GETFL, 0);
+		net_fcntl(server, F_SETFL, (flags < 0 ? 0 : flags) | IOS_O_NONBLOCK);
+		evlog("video listening on port %d", port);
+		return server;
+	}
+	evlog("video: no free port in %d..%d", EVNET_VIDEO_PORT, EVNET_VIDEO_PORT + VIDEO_PORT_COUNT - 1);
+	return -1;
+}
+
+static void* vidMain(void* arg) {
+	(void) arg;
+	for (;;) {
+		while (!evNetUp) {
+			usleep(200000);
+		}
+		s32 server = vidOpenServer();
+		if (server < 0) {
+			sleep(2);
+			continue;
+		}
+		vidServerSock = server;
+		int failures = 0;
+		while (evNetUp && failures < 50) {
+			struct sockaddr_in peer;
+			socklen_t peerLen = sizeof(peer);
+			s32 client = net_accept(server, (struct sockaddr*) &peer, &peerLen);
+			if (client < 0) {
+				if (client != -EAGAIN && client != -EWOULDBLOCK) {
+					++failures;
+				}
+				usleep(100000);
+				continue;
+			}
+			failures = 0;
+			s32 flags = net_fcntl(client, F_GETFL, 0);
+			net_fcntl(client, F_SETFL, (flags < 0 ? 0 : flags) & ~IOS_O_NONBLOCK);
+			vidClientSock = client;
+			vidServe(client);
+			vidClientSock = -1;
+			net_close(client);
+		}
+		vidServerSock = -1;
+		net_close(server);
+		sleep(1);
+	}
+	return NULL;
+}
+
+static void* evMain(void* arg) {
+	(void) arg;
+	evlog("server thread running");
+	for (;;) {
+		/* (re)start the network stack until it works: Wi-Fi may not be up yet */
+		int tries = 0;
+		s32 res;
+		while ((res = net_init()) < 0) {
+			if (tries++ < 20) {
+				evlog("net_init failed: %d (try %d)", (int) res, tries);
+			}
+			sleep(2);
+		}
+		evlog("net_init ok");
+		s32 server = openServer();
+		if (server < 0) {
+			net_deinit();
+			sleep(2);
+			continue;
+		}
+		evServerSock = server;
+		evNetUp = true;
+		int failures = 0;
+		s32 client = -1;
+		while (failures < 5) {
+			if (client < 0) {
+				struct sockaddr_in peer;
+				socklen_t peerLen = sizeof(peer);
+				client = net_accept(server, (struct sockaddr*) &peer, &peerLen);
+				if (client < 0) {
+					if (!wouldBlock(client)) {
+						++failures;
+						evlog("net_accept failed: %d (failure %d)", (int) client, failures);
+						sleep(1);
+					} else {
+						usleep(100000);
+					}
+					client = -1;
+					continue;
+				}
+				setNonBlocking(client);
+			}
+			failures = 0;
+			evClientSock = client;
+			s32 next = serve(server, client);
+			evClientSock = -1;
+			net_close(client);
+			client = next;
+		}
+		/* the listening socket looks dead: build everything again */
+		evlog("rebuilding the network stack");
+		evNetUp = false;
+		evServerSock = -1;
+		net_close(server);
+		net_deinit();
+	}
+	return NULL;
+}
+
+static void evAtExit(void) {
+	/* mGBA is leaving: release the sockets, otherwise the Wii's network stack may keep them */
+	if (evClientSock >= 0) {
+		net_close(evClientSock);
+	}
+	if (evServerSock >= 0) {
+		net_close(evServerSock);
+	}
+	evNetUp = false;
+	if (vidClientSock >= 0) {
+		net_close(vidClientSock);
+	}
+	if (vidServerSock >= 0) {
+		net_close(vidServerSock);
+	}
+	net_deinit();
+	evlog("exit: sockets released");
+}
+
+void evnet_start(struct mCore* core) {
+	if (!evAtExitSet) {
+		evAtExitSet = true;
+		atexit(evAtExit);
+	}
+	evReset = true;
+	evCore = core;
+	if (evThreadStarted) {
+		evlog("game loaded (server thread already running)");
+		return;
+	}
+	s32 res = LWP_CreateThread(&evThread, evMain, NULL, NULL, 16 * 1024, EVNET_PRIORITY);
+	if (res == 0) {
+		evThreadStarted = true;
+		evlog("game loaded, server thread created");
+	} else {
+		evlog("LWP_CreateThread failed: %d", (int) res);
+		return;
+	}
+	if (LWP_MutexInit(&vidLock, false) != 0) {
+		vidLock = LWP_MUTEX_NULL;
+		evlog("video: LWP_MutexInit failed");
+		return;
+	}
+	res = LWP_CreateThread(&vidThread, vidMain, NULL, NULL, 16 * 1024, VIDEO_PRIORITY);
+	if (res == 0) {
+		evlog("video thread created");
+	} else {
+		evlog("video: LWP_CreateThread failed: %d", (int) res);
+	}
+}
+
+void evnet_stop(void) {
+	/* The network thread keeps running; it just stops reading emulator memory.
+	 * Wait for a slice that is in progress, because the core is freed right after this returns. */
+	evCore = NULL;
+	while (evReading) {
+		usleep(1000);
+	}
+	evlog("game unloaded");
+}
